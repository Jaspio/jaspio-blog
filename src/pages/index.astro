---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostTerms from '../components/PostTerms.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 10);
const renderedPosts = await Promise.all(
	posts.map(async (post) => ({ post, Content: (await render(post)).Content })),
);
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="archive-page">
	{renderedPosts.map(({ post, Content }) => (
		<article class="post post-single">
			<div class="post-inner">
				<header class="post-header">
					<h2 class="post-title">{post.data.title}</h2>
					<p class="post-meta">
						<FormattedDate date={post.data.pubDate} />
						{post.data.author && <><span class="date-sep">/</span>{post.data.author}</>}
					</p>
				</header>
				<div class="post-content"><Content /></div>
			</div>
			<PostTerms categories={post.data.categories} tags={post.data.tags} />
		</article>
	))}
</SiteLayout>
