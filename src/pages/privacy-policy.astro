---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/BlogPost.astro';

const privacy = await getEntry('pages', 'privacy-policy');

if (!privacy) {
	throw new Error('The privacy page was not found in the pages collection.');
}

const { Content } = await render(privacy);
---

<Layout
	title={privacy.data.title}
	description={privacy.data.description ?? privacy.data.excerpt ?? ''}
>
	<div class="privacy-content">
		<Content />
	</div>
</Layout>
