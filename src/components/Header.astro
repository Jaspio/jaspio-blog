---
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import CategoryTree from './CategoryTree.astro';

const [posts, tags] = await Promise.all([getCollection('blog'), getCollection('tags')]);
const recentPosts = posts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
const sortedTags = tags.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<aside class="site-sidebar">
	<div class="blog-header">
		<h1 class="blog-title"><a href="/">{SITE_TITLE}</a></h1>
		<p class="blog-description">{SITE_DESCRIPTION}</p>
	</div>
	<details class="sidebar-details" open>
		<summary class="mobile-menu-toggle">
			<span>Show menu</span>
			<span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
		</summary>
		<div class="sidebar-content">
			<nav class="blog-menu" aria-label="Main navigation">
				<ul>
					<li><HeaderLink href="/">Home</HeaderLink></li>
					<li><HeaderLink href="/about">About Me</HeaderLink></li>
				</ul>
			</nav>
			<section class="sidebar-widget" aria-labelledby="recent-posts-heading">
				<h2 id="recent-posts-heading">Recent Posts</h2>
				<ul class="recent-posts">
					{recentPosts.map((post) => (
						<li><a href={`/blog/${post.id}/`}>{post.data.title}</a></li>
					))}
				</ul>
			</section>
			<section class="sidebar-widget" aria-labelledby="categories-heading">
				<h2 id="categories-heading"><a href="/category/">Categories</a></h2>
				<CategoryTree showCounts />
			</section>
			<section class="sidebar-widget" aria-labelledby="tags-heading">
				<h2 id="tags-heading"><a href="/tag/">Tags</a></h2>
				<ul class="taxonomy-list sidebar-tags">
					{sortedTags.map((tag) => (
						<li><a href={`/tag/${tag.id}/`}>{tag.data.name}</a></li>
					))}
				</ul>
			</section>
		</div>
	</details>
</aside>

<script>
	const sidebarDetails = document.querySelector('.sidebar-details');
	const mobileBreakpoint = window.matchMedia('(max-width: 788px)');

	const syncSidebarMenu = () => {
		if (sidebarDetails instanceof HTMLDetailsElement) {
			sidebarDetails.open = !mobileBreakpoint.matches;
		}
	};

	syncSidebarMenu();
	mobileBreakpoint.addEventListener('change', syncSidebarMenu);
</script>
