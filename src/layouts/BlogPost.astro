---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostTerms from '../components/PostTerms.astro';
import SiteLayout from './SiteLayout.astro';


interface Props {
	title: string;
	description: string;
	pubDate?: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	author?: string;
	categories?: string[];
	tags?: string[];
}

const { title, description, pubDate, updatedDate, heroImage, author, categories = [], tags = [] } = Astro.props;
---

<SiteLayout title={title} description={description} mainClass="single-page">
	<article class="post post-single">
		{heroImage && (
			<div class="featured-media">
				<Image width={1020} height={510} src={heroImage} alt="" />
			</div>
		)}
		<div class="post-inner">
			<header class="post-header">
				<h1 class="post-title">{title}</h1>
				{pubDate && (
					<p class="post-meta">
						<FormattedDate date={pubDate} />
						{author && <><span class="date-sep">/</span>{author}</>}
					</p>
				)}
				{updatedDate && (
					<p class="post-meta">Updated <FormattedDate date={updatedDate} /></p>
				)}
			</header>
			<div class="post-content">
				<slot />
			</div>
		</div>
		<PostTerms categories={categories} tags={tags} />
	</article>
</SiteLayout>
